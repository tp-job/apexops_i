# ────────────────────────────────────────────────────────────────
# ApexOps root env — used by docker-compose. Copy to `.env`.
# Per-service overrides live in ./server/.env and ./client/.env.
# ────────────────────────────────────────────────────────────────

# Postgres
PG_USER=postgres
PG_PASSWORD=change-me
PG_DATABASE=apexops_db
PG_PORT=5432

# Server (JWT — MUST be strong random 32+ chars in production)
JWT_SECRET=change-me-32-plus-chars-of-random
JWT_REFRESH_SECRET=change-me-32-plus-chars-of-random
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost
GEMINI_API_KEY=

# Client (build-time API base URL)
VITE_API_URL=http://localhost:3000
