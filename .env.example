# ────────────────────────────────────────────────────────────────
# ApexOps root env — used by docker-compose. Copy to `.env`.
# Per-service overrides live in ./server/.env and ./client/.env.
# ────────────────────────────────────────────────────────────────

# Postgres
PG_USER=postgres
PG_PASSWORD=change-me
PG_DATABASE=apexops_db
PG_PORT=5432

# Server (JWT — MUST be strong random 32+ chars in production)
JWT_SECRET=change-me-32-plus-chars-of-random
JWT_REFRESH_SECRET=change-me-32-plus-chars-of-random
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost

# Org-wide fallback AI key. Used only when the signed-in user has not stored
# their own (BYOK). Leave blank to require every user to bring a key.
GEMINI_API_KEY=

# Encrypts user-supplied provider API keys at rest (AES-256-GCM).
#
# MUST differ from JWT_SECRET — one secret covering both session signing and
# stored credentials means a single leak costs both, and rotating it for one
# reason silently destroys the other. The server refuses to start in production
# if it is missing, too short, or equal to JWT_SECRET.
#
# Rotating this makes every stored user key undecryptable; users must re-enter
# them. That is by design, and it is the revocation path.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEY_SECRET=change-me-32-plus-chars-of-random

# Client (build-time API base URL)
VITE_API_URL=http://localhost:3000
