{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:dev": "ts-node -T src/scripts/seed-dev-users.ts",
    "backfill:projects": "ts-node -T src/scripts/backfill-default-project.ts",
    "prune:events": "ts-node -T src/scripts/prune-events.ts",
    "migrate:session-timeout": "ts-node -T src/scripts/migrate-session-timeout.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "schema": "../../database/prisma/schema.prisma"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "7.0.13",
    "pg": "^8.16.3",
    "puppeteer": "^23.11.1",
    "socket.io": "^4.8.1",
    "source-map": "0.7.4",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.2",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "axios": "^1.13.2",
    "nodemon": "^3.1.10",
    "prisma": "^6.19.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
