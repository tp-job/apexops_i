# Vite build-time env — copy to `.env` for local dev
VITE_API_URL=http://localhost:3000

# Offline mock defaults to ON in dev (utils/offlineMock.ts falls back to
# `!!import.meta.env.DEV` when this is unset). Keep it explicitly false for normal
# work so a dead backend looks dead instead of quietly serving fixture data.
VITE_ENABLE_OFFLINE_MOCK=false
