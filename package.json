{
  "name": "apexops",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["app/client", "app/server"],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "dev": "npm run dev --workspaces --if-present",
    "dev:client": "npm run dev --workspace app/client",
    "dev:server": "npm run dev --workspace app/server",
    "build": "npm run build --workspaces --if-present",
    "start:server": "npm run start --workspace app/server",
    "lint": "npm run lint --workspace app/client",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }
}
