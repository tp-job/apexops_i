generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────
model User {
  id             Int       @id @default(autoincrement())
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String    @unique
  password       String
  phone          String?
  company        String?
  position       String?
  location       String?
  timezone       String?   @default("Asia/Bangkok (GMT+7)")
  bio            String?
  avatarUrl      String?   @map("avatar_url")
  role           String?   @default("user")
  gender         String?
  birthDate      DateTime? @map("birth_date") @db.Date
  language       String?   @default("ไทย (Thai)")
  /// 'light' | 'dark' | 'system'. Persisted per account so the choice follows you
  /// to a new browser (spec D7) — localStorage alone made it a per-device quirk.
  /// `language` above is deliberately NOT surfaced anywhere: there is no i18n
  /// framework, so a language control would be exactly the dead switch S-D1 bans.
  theme          String?   @default("system")
  isActive       Boolean?  @default(true) @map("is_active")
  emailVerified  Boolean?  @default(false) @map("email_verified")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  settings        UserSettings?
  notes           Note[]
  logs            Log[]
  refreshTokens   RefreshToken[]
  assignedTickets Ticket[]        @relation("assignee")
  reportedTickets Ticket[]        @relation("reporter")
  ticketComments  TicketComment[] @relation("commentAuthor")
  ownedProjects   Project[]       @relation("projectOwner")
  uploadedSourceMaps SourceMap[]  @relation("sourceMapUploader")
  projectMemberships ProjectMember[]
  sentInvites        ProjectInvite[]     @relation("inviteSender")
  issueStatusChanges IssueStatusChange[]
  notifications      Notification[]

  @@map("users")
}

// ── User Settings ────────────────────────────────────────────
model UserSettings {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique @map("user_id")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  pushNotifications  Boolean  @default(true) @map("push_notifications")
  bugAlerts          Boolean  @default(true) @map("bug_alerts")
  weeklyReports      Boolean  @default(false) @map("weekly_reports")
  teamUpdates        Boolean  @default(true) @map("team_updates")
  twoFactorAuth      Boolean  @default(false) @map("two_factor_auth")
  /// Idle timeout in minutes (spec D1): it bounds the refresh token's sliding
  /// window, not just the access token, because a shorter access token alone is
  /// invisible — the client silently re-issues it.
  ///
  /// Default moved 30 -> 480 on 2026-08-04 (D3). Nobody ever chose 30; it was a
  /// column default from a page that had no control for it. Enforcing it as
  /// written would have shipped this sprint as "the app started logging me out".
  sessionTimeout     Int      @default(480) @map("session_timeout")
  loginAlerts        Boolean  @default(true) @map("login_alerts")
  profileVisibility  Boolean  @default(true) @map("profile_visibility")
  activityStatus     Boolean  @default(true) @map("activity_status")
  dataCollection     Boolean  @default(false) @map("data_collection")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ── Logs ─────────────────────────────────────────────────────
model Log {
  id        Int      @id @default(autoincrement())
  level     String
  message   String
  source    String?
  stack     String?
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("logs")
}

// ── Notes ────────────────────────────────────────────────────
model Note {
  id             Int      @id @default(autoincrement())
  userId         Int?     @map("user_id")
  title          String
  content        String?
  type           String?  @default("text")
  isPinned       Boolean  @default(false) @map("is_pinned")
  color          String?
  tags           Json     @default("[]")
  imageUrl       String?  @map("image_url")
  linkUrl        String?  @map("link_url")
  checklistItems Json     @default("[]") @map("checklist_items")
  quote          Json     @default("{}")
  /// The day this note is *planned for*. Null means unscheduled, in which case
  /// the calendar falls back to `createdAt` — so existing rows keep appearing
  /// exactly where they did before this field existed.
  scheduledFor   DateTime? @map("scheduled_for")
  /// Optional deadline, independent of `scheduledFor` (plan a task Monday, due Friday).
  dueDate        DateTime? @map("due_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPinned])
  @@index([userId, scheduledFor])
  @@index([userId, dueDate])
  @@map("notes")
}

// ── Projects / workspaces ────────────────────────────────────
// Scoping root for everything the embeddable SDK produces (spec D1).
// Spec: .agents/docs/features/project-workspaces-and-sdk.md

enum ProjectRole {
  owner
  admin
  member

  @@map("project_role")
}

model Project {
  id   Int    @id @default(autoincrement())
  name String
  /// URL segment: /p/:slug. Project lives in the URL, not a client store, so
  /// deep links, the back button and two tabs on two projects all work.
  slug String @unique
  /// PUBLIC by design (spec D4) — it ships inside a <script> tag on pages we do
  /// not control, so it can never be a secret. It is write-only (ingest and
  /// nothing else), rate limited per key, and rotatable. Reads use the JWT session.
  ingestKey String @unique @map("ingest_key")
  /// Optional origin allowlist for ingest. Empty array means any origin.
  allowedOrigins Json @default("[]") @map("allowed_origins")
  /// Which console levels the SDK ships (spec D5). `log`/`info`/`debug` are
  /// opt-in — capturing them by default floods the store from a chatty dev app.
  captureLevels Json @default("[\"error\",\"warn\"]") @map("capture_levels")
  /// Days of raw `Event` rows to keep. `Issue` aggregates are never pruned.
  retentionDays Int       @default(30) @map("retention_days")

  /// Alerting is configured **per project**, not per user (spec S-D4): "alert me
  /// about this project" is the useful control; "alert me about everything" is
  /// not. On by default — a regression you already fixed coming back is the one
  /// event worth interrupting someone for.
  alertOnRegression Boolean @default(true) @map("alert_on_regression")
  /// Optional Slack/Discord/generic incoming webhook. USER-SUPPLIED, so the
  /// server making outbound requests to it is an SSRF surface — every send goes
  /// through `lib/webhook.ts`, which rejects private and link-local targets.
  webhookUrl String? @map("webhook_url")

  ownerId       Int       @map("owner_id")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  owner   User            @relation("projectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  invites ProjectInvite[]
  issues  Issue[]
  events  Event[]
  tickets Ticket[]
  sourceMaps SourceMap[]

  @@index([ownerId])
  @@index([archivedAt])
  @@map("projects")
}

/// Modelled from day one even though v1 ships owner-only, with no invite UI.
/// Retrofitting membership later means rewriting every authorization check.
model ProjectMember {
  projectId Int         @map("project_id")
  userId    Int         @map("user_id")
  role      ProjectRole @default(member)
  createdAt DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum InviteStatus {
  pending
  accepted
  revoked

  @@map("invite_status")
}

/// A pending grant of membership, delivered as a link the inviter passes on
/// themselves (spec T-D1) — there is no mail infrastructure, so "invite by
/// email" would mean owning a sending domain and a deliverability problem.
model ProjectInvite {
  id        Int         @id @default(autoincrement())
  projectId Int         @map("project_id")
  /// Lowercased at write time. The invite is BOUND to this address: accepting
  /// requires being signed in as a matching account, so a link forwarded into
  /// the wrong channel is a dead link rather than a breach.
  email String
  role  ProjectRole @default(member)
  /// SHA-256 of the token. The token itself is returned once, at creation, and
  /// never stored — reading this table must not grant workspace access, for the
  /// same reason a password column holds a hash.
  tokenHash    String       @unique @map("token_hash")
  status       InviteStatus @default(pending)
  invitedById  Int          @map("invited_by_id")
  expiresAt    DateTime     @map("expires_at")
  acceptedAt   DateTime?    @map("accepted_at")
  acceptedById Int?         @map("accepted_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("inviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  /// One live invite per address per project. Re-inviting updates the row and
  /// mints a new token rather than accumulating duplicates in the pending list.
  @@unique([projectId, email])
  @@index([projectId, status])
  @@map("project_invites")
}

// ── Issues / events (SDK ingest) ─────────────────────────────

enum IssueStatus {
  unresolved
  resolved
  ignored

  @@map("issue_status")
}

/// The grouped, deduplicated unit the UI lists (spec D3). A render loop that
/// throws 100k times is ONE issue with count 100000 — without this the first
/// real integration makes the UI useless and the database large on the same day.
model Issue {
  id        Int    @id @default(autoincrement())
  projectId Int    @map("project_id")
  /// hash(projectId, level, normalizedMessage, topStackFrame). Normalization
  /// strips numbers, UUIDs and quoted strings so `User 4821 not found` and
  /// `User 9134 not found` collapse into one issue.
  fingerprint String
  level       String
  /// First line of the message.
  title   String
  /// Top stack frame, e.g. `app.js:42`.
  culprit  String?
  status   IssueStatus @default(unresolved)
  count    Int         @default(1)
  firstSeen DateTime   @default(now()) @map("first_seen")
  lastSeen  DateTime   @default(now()) @map("last_seen")
  /// Set when the issue is promoted to tracked work on the Bug Tracker board.
  ticketId Int? @unique @map("ticket_id")

  /// Denormalized regression counters.
  ///
  /// `IssueStatusChange` is the source of truth and answers "how many regressions
  /// this week"; these two answer "has this ever come back" on the issue list,
  /// where a join per row would be paid on the hottest read in the product.
  /// Both are maintained in the same transaction as the audit row.
  reopenCount    Int       @default(0) @map("reopen_count")
  lastReopenedAt DateTime? @map("last_reopened_at")

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket        Ticket?             @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  events        Event[]
  statusChanges IssueStatusChange[]

  /// The ingest upsert target — makes repeated ingest of the same error idempotent.
  @@unique([projectId, fingerprint])
  @@index([projectId, status, lastSeen])
  @@map("issues")
}

/// What an alert is about. Only `regression` fires today; the enum exists so
/// adding a kind later does not require a migration on a table with rows.
enum NotificationKind {
  regression
  /// Written when the invited address already has an account — the common case
  /// in a small team, and the only in-product channel an invite has.
  invite

  @@map("notification_kind")
}

/// The in-app alert feed — and the **system of record** for alerting.
///
/// Webhooks are fire-and-forget: if one silently stops delivering, that is
/// indistinguishable from "no regressions happened", which is the worst failure
/// mode a monitoring tool has. A row here is written first and unconditionally,
/// so there is always a durable record of what we *tried* to tell you, whatever
/// the outbound channel did.
///
/// Fan-out is one row per member per event. That is deliberate: read state is
/// per person, so a shared row would mean one member marking it read hides it
/// from everyone else.
model Notification {
  id     Int              @id @default(autoincrement())
  userId Int              @map("user_id")
  kind   NotificationKind
  /// Denormalized so the feed can filter/link by project without a join.
  projectId Int  @map("project_id")
  issueId   Int? @map("issue_id")
  title     String
  body      String?
  /// Null until read. Nullable-timestamp rather than a boolean so "when did they
  /// see it" stays answerable.
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Drives the unread badge and the feed, both of which are per-user newest-first.
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Why an issue's status changed. `regression` is written by ingest with no
/// actor; `manual` is a person.
enum IssueStatusChangeReason {
  regression
  manual

  @@map("issue_status_change_reason")
}

/// Every status transition, so "3 regressions this week" is answerable.
///
/// `Issue.status` holds only the *current* value, so before this table a
/// resolved issue that recurred flipped back to `unresolved` and no trace of the
/// flip survived — the single most actionable number on a project overview was
/// uncomputable. Volume is bounded by human actions plus genuine regressions,
/// not by ingest, so this stays small even under a flood.
model IssueStatusChange {
  id      Int @id @default(autoincrement())
  issueId Int @map("issue_id")
  /// Denormalized from the issue for the same reason `Event.projectId` is:
  /// the cross-project roll-up counts regressions per project over a window,
  /// and without it every row of that query needs a join through `issues`.
  projectId  Int                     @map("project_id")
  fromStatus IssueStatus             @map("from_status")
  toStatus   IssueStatus             @map("to_status")
  reason     IssueStatusChangeReason
  /// Null for automatic regressions — ingest has no signed-in user.
  actorId   Int?     @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  /// Drives "regressions in the last N days", per project and across projects.
  @@index([projectId, reason, createdAt])
  @@map("issue_status_changes")
}

/// One raw occurrence, pruned on the project's retention window. Deliberately
/// separate from `Log`: that table is ApexOps' own trusted server log, this one
/// is untrusted, attacker-controllable, high-volume third-party input (spec D2).
model Event {
  /// BigInt is deliberate — this is the one table with a credible path to 10^8
  /// rows, and Int overflow at 2.1B is an outage with no fast fix. Note it does
  /// not JSON.stringify: the API must serialize it as a string.
  id        BigInt   @id @default(autoincrement())
  projectId Int      @map("project_id")
  issueId   Int      @map("issue_id")
  level     String
  message   String
  stack     String?
  url       String?
  userAgent String?  @map("user_agent")
  /// Version string from the SDK's `data-release`, for future source-map support.
  release   String?
  /// SDK-supplied tags/breadcrumbs.
  context   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  /// Drives the retention prune job.
  @@index([projectId, createdAt])
  @@map("events")
}

/// Uploaded JavaScript source maps, used to turn a minified stack frame back
/// into original file/line/function at issue-detail read time.
///
/// **Stored in Postgres rather than on disk, deliberately.** `server.ts` serves
/// `public/` statically so the SDK can be fetched from a page we do not control.
/// A filesystem store would be permanently one misconfigured path away from
/// publishing the customer's original source — the single worst outcome
/// available in this feature. In a column, no URL serves it: the failure mode is
/// removed by construction instead of by vigilance.
model SourceMap {
  id        Int    @id @default(autoincrement())
  projectId Int    @map("project_id")
  /// Must match `Event.release` exactly — that is the whole job `data-release`
  /// exists to do. A map with no release could never be matched to a frame.
  release   String
  /// **Basename** of the generated file, e.g. `index-BwlN_KfP.js`. Basename and
  /// not the full URL, so one upload works whether the bundle is served from a
  /// CDN, a subpath or localhost.
  fileName  String @map("file_name")
  /// The raw `.map` JSON, verbatim.
  ///
  /// NEVER SERVED. No endpoint returns this column and none may be added: it is
  /// the customer's original source. `lib/sourcemaps.ts` is the only place that
  /// selects it, and only resolved positions leave the server.
  content   String
  /// Bytes, denormalized so the settings list can show sizes without reading
  /// the content column it is forbidden from touching.
  size      Int
  /// Null once the uploader's account is deleted — attribution is history.
  uploadedById Int?  @map("uploaded_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("sourceMapUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// Re-uploading the same file for the same release REPLACES it. Deploys get
  /// re-run; accumulating rows would make the list useless and storage unbounded.
  @@unique([projectId, release, fileName])
  @@index([projectId, release])
  @@map("source_maps")
}

// ── Tickets ──────────────────────────────────────────────────

/// Wire values stay hyphenated (`in-progress`) — the API maps enum <-> wire so the
/// client's discriminated unions in `types/bugTrackerApp.ts` keep working unchanged.
enum TicketStatus {
  open
  in_progress @map("in-progress")
  resolved
  closed

  @@map("ticket_status")
}

enum TicketPriority {
  low
  medium
  high
  critical

  @@map("ticket_priority")
}

model Ticket {
  id          Int            @id @default(autoincrement())
  /// Required as of the D1 migration. Reaching this state took three steps —
  /// push nullable, run `scripts/backfill-default-project.ts`, push required —
  /// because a one-shot NOT NULL column fails on any existing row and this repo
  /// uses `db push` with no migrations directory.
  projectId   Int            @map("project_id")
  title       String
  description String?
  status      TicketStatus   @default(open)
  priority    TicketPriority @default(medium)
  /// Legacy free-text names, kept only as a display denorm while the FK columns
  /// below become the source of truth (spec D2). Dropped once no reads remain.
  assignee    String?
  reporter    String?        @default("System")
  assigneeId  Int?           @map("assignee_id")
  reporterId  Int?           @map("reporter_id")
  tags        Json           @default("[]")
  relatedLogs Json           @default("[]") @map("related_logs")
  /// Soft delete (spec D4) — `DELETE /:id` archives instead of destroying.
  archivedAt  DateTime?      @map("archived_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeUser User?           @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterUser User?           @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  comments     TicketComment[]
  /// Set when this ticket was promoted from an ingested issue.
  issue        Issue?

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([status])
  @@index([archivedAt])
  @@map("tickets")
}

// ── Ticket comments / activity ───────────────────────────────

enum TicketCommentKind {
  comment
  activity

  @@map("ticket_comment_kind")
}

/// One thread per ticket carrying both human comments and system-generated
/// activity entries (status/priority/assignee changes), so triage history reads
/// in a single chronological stream.
model TicketComment {
  id        Int               @id @default(autoincrement())
  ticketId  Int               @map("ticket_id")
  authorId  Int?              @map("author_id")
  kind      TicketCommentKind @default(comment)
  body      String
  /// For `activity` entries: `{ field, from, to }`. Empty for human comments.
  meta      Json              @default("{}")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation("commentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("ticket_comments")
}

// ── Refresh Tokens ───────────────────────────────────────────
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  /// Context for the active-sessions list (spec S-D3). A session list that says
  /// "session #4" is unusable; one that says "Chrome on Windows, 2 hours ago" is
  /// the difference between a security control and a table of row ids.
  /// Nullable: sessions created before this landed have no context to show.
  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  /// The hard end of this session, stamped once at login and CARRIED FORWARD
  /// through every rotation (spec D2). `expiresAt` is now a sliding idle window
  /// (D1), so without this a session refreshed just inside its window would never
  /// end — and neither would a stolen refresh token. Refusing to rotate past this
  /// is what makes "sessions expire" true rather than nominal.
  ///
  /// Nullable so rows predating it keep working: they are treated as uncapped and
  /// stamped on their first rotation, rather than logging everyone out on deploy.
  absoluteExpiresAt DateTime? @map("absolute_expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}
